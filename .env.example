# MongoDB (MongoDB Atlas: Database > Connect > Drivers)
# Nama database ada setelah "/" (tanpa nama, MongoDB memakai database "test").
# Di laptop pakai database development; production diisi di .env.production.local & Vercel.
DATABASE_URL=mongodb+srv://USERNAME:PASSWORD_ASLI@cluster0.xxxxx.mongodb.net/ponpes-dev?retryWrites=true&w=majority

# String acak panjang untuk enkripsi login admin. Buat dengan: openssl rand -hex 32
PAYLOAD_SECRET=

# Alamat website (tanpa / di akhir). Dipakai untuk sitemap, canonical URL, dan preview share
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Izinkan Google mengindeks website. Isi true HANYA di Vercel Production saat siap go-live
ALLOW_INDEXING=false

# S3 IDCloudHost. Kosongkan S3_BUCKET untuk menyimpan upload di folder lokal /media saat development
S3_BUCKET=
S3_ENDPOINT=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Folder di bucket. Pakai media-dev untuk database development; production pakai media (default)
S3_PREFIX=media-dev
