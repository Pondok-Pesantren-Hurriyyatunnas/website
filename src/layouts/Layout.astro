---
import '../styles/global.css';
import site from '../data/site.json';
import Logo from '../components/Logo.astro';

interface Props {
  title?: string;
  description?: string;
}

const { title, description = site.description } = Astro.props;
const fullTitle = title ? `${title} | ${site.name}` : site.name;
const path = Astro.url.pathname.replace(/\/$/, '') || '/';

const navItems = [
  { href: '/', label: 'Beranda' },
  { href: '/profil', label: 'Profil' },
  { href: '/program', label: 'Program' },
  { href: '/berita', label: 'Berita' },
  { href: '/galeri', label: 'Galeri' },
  { href: '/kontak', label: 'Kontak' },
];

const isActive = (href: string) => (href === '/' ? path === '/' : path.startsWith(href));
const waUrl = `https://wa.me/${site.whatsapp}?text=${encodeURIComponent(`Assalamu'alaikum, saya ingin bertanya tentang ${site.name}.`)}`;
const year = new Date().getFullYear();
---

<!doctype html>
<html lang="id">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Amiri:wght@700&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="flex min-h-screen flex-col bg-white font-sans text-slate-800 antialiased">
    <header class="sticky top-0 z-40 border-b border-brand-100 bg-white/95 backdrop-blur">
      <div class="mx-auto flex max-w-6xl items-center justify-between px-4 py-3">
        <a href="/" class="flex items-center gap-3">
          <Logo class="h-11 w-11" />
          <div class="leading-tight">
            <div class="text-xs font-medium text-brand-600">Pondok Pesantren</div>
            <div class="font-bold text-brand-900">Hurriyyatunnas Bakti Awo</div>
          </div>
        </a>

        <nav class="hidden items-center gap-1 lg:flex">
          {navItems.map((item) => (
            <a
              href={item.href}
              class:list={[
                'rounded-lg px-3 py-2 text-sm font-medium transition',
                isActive(item.href) ? 'bg-brand-50 text-brand-700' : 'text-slate-600 hover:text-brand-700',
              ]}
            >
              {item.label}
            </a>
          ))}
          <a href="/psb" class="ml-2 rounded-full bg-gold-500 px-5 py-2 text-sm font-bold text-brand-950 transition hover:bg-gold-400">
            Daftar Santri Baru
          </a>
        </nav>

        <button id="menu-btn" class="rounded-lg p-2 text-brand-800 lg:hidden" aria-label="Buka menu" aria-expanded="false">
          <svg class="h-6 w-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M4 6h16M4 12h16M4 18h16" /></svg>
        </button>
      </div>

      <nav id="mobile-menu" class="hidden border-t border-brand-100 bg-white px-4 pb-4 lg:hidden">
        {navItems.map((item) => (
          <a
            href={item.href}
            class:list={['block rounded-lg px-3 py-3 font-medium', isActive(item.href) ? 'bg-brand-50 text-brand-700' : 'text-slate-700']}
          >
            {item.label}
          </a>
        ))}
        <a href="/psb" class="mt-2 block rounded-full bg-gold-500 px-5 py-3 text-center font-bold text-brand-950">Daftar Santri Baru</a>
      </nav>
    </header>

    <main class="flex-1">
      <slot />
    </main>

    <footer class="bg-brand-950 text-brand-100">
      <div class="mx-auto grid max-w-6xl gap-10 px-4 py-14 md:grid-cols-3">
        <div>
          <div class="flex items-center gap-3">
            <Logo class="h-12 w-12" />
            <div class="font-bold text-white">{site.name}</div>
          </div>
          <p class="mt-4 text-sm text-brand-200/80">{site.tagline}</p>
        </div>
        <div>
          <h3 class="mb-4 font-semibold text-gold-400">Tautan</h3>
          <ul class="grid grid-cols-2 gap-2 text-sm">
            {navItems.map((item) => <li><a href={item.href} class="hover:text-white">{item.label}</a></li>)}
            <li><a href="/psb" class="hover:text-white">PSB</a></li>
          </ul>
        </div>
        <div>
          <h3 class="mb-4 font-semibold text-gold-400">Kontak</h3>
          <ul class="space-y-2 text-sm">
            <li>{site.address}</li>
            <li>Telp: {site.phone}</li>
            <li>Email: {site.email}</li>
          </ul>
          <div class="mt-4 flex gap-3 text-sm">
            {site.instagram && <a href={site.instagram} class="hover:text-white">Instagram</a>}
            {site.facebook && <a href={site.facebook} class="hover:text-white">Facebook</a>}
            {site.youtube && <a href={site.youtube} class="hover:text-white">YouTube</a>}
          </div>
        </div>
      </div>
      <div class="border-t border-white/10 py-5 text-center text-xs text-brand-200/60">
        © {year} {site.name}. Hak cipta dilindungi.
      </div>
    </footer>

    <a
      href={waUrl}
      target="_blank"
      rel="noopener"
      class="fixed right-4 bottom-4 z-50 flex items-center gap-2 rounded-full bg-[#25D366] px-4 py-3 font-semibold text-white shadow-lg transition hover:scale-105"
      aria-label="Chat WhatsApp"
    >
      <svg class="h-6 w-6" viewBox="0 0 24 24" fill="currentColor"><path d="M17.47 14.38c-.3-.15-1.76-.87-2.03-.97-.27-.1-.47-.15-.67.15-.2.3-.77.97-.94 1.17-.17.2-.35.22-.65.07-.3-.15-1.26-.46-2.4-1.48-.89-.79-1.49-1.77-1.66-2.07-.17-.3-.02-.46.13-.61.13-.13.3-.35.45-.52.15-.17.2-.3.3-.5.1-.2.05-.37-.02-.52-.08-.15-.67-1.62-.92-2.22-.24-.58-.49-.5-.67-.51h-.57c-.2 0-.52.07-.8.37-.27.3-1.04 1.02-1.04 2.48s1.07 2.88 1.21 3.08c.15.2 2.1 3.2 5.08 4.49.71.31 1.26.49 1.69.63.71.23 1.36.2 1.87.12.57-.08 1.76-.72 2.01-1.42.25-.7.25-1.29.17-1.42-.07-.12-.27-.2-.57-.35zM12.04 21.5h-.01a9.4 9.4 0 0 1-4.8-1.32l-.34-.2-3.57.94.95-3.48-.22-.36a9.43 9.43 0 0 1-1.45-5.03c0-5.2 4.24-9.44 9.45-9.44 2.52 0 4.9.99 6.68 2.77a9.38 9.38 0 0 1 2.76 6.68c0 5.21-4.24 9.44-9.45 9.44zm8.04-17.48A11.3 11.3 0 0 0 12.04.7C5.77.7.66 5.8.66 12.07c0 2 .52 3.96 1.52 5.69L.57 23.65l6.03-1.58a11.35 11.35 0 0 0 5.43 1.38h.01c6.27 0 11.38-5.1 11.38-11.38 0-3.04-1.18-5.9-3.33-8.05z" /></svg>
      <span class="hidden sm:inline">Tanya via WhatsApp</span>
    </a>

    <script>
      const btn = document.getElementById('menu-btn');
      const menu = document.getElementById('mobile-menu');
      btn?.addEventListener('click', () => {
        const open = menu?.classList.toggle('hidden') === false;
        btn.setAttribute('aria-expanded', String(open));
      });
    </script>
  </body>
</html>
