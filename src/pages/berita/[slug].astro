---
import { render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import { formatDate, getPublishedNews } from '../../lib/format';

export async function getStaticPaths() {
  const posts = await getPublishedNews();
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { title, date, category, thumbnail, excerpt } = post.data;
const { Content } = await render(post);
---

<Layout title={title} description={excerpt}>
  <article class="mx-auto max-w-3xl px-4 py-12">
    <a href="/berita" class="text-sm font-semibold text-brand-700 hover:underline">← Kembali ke berita</a>
    <div class="mt-6 flex items-center gap-2 text-sm">
      <span class="rounded-full bg-brand-50 px-3 py-1 font-semibold text-brand-700">{category}</span>
      <span class="text-slate-500">{formatDate(date)}</span>
    </div>
    <h1 class="mt-4 text-3xl leading-tight font-extrabold text-brand-950 md:text-4xl">{title}</h1>
    {thumbnail && <img src={thumbnail} alt={title} class="mt-8 w-full rounded-2xl" />}
    <div class="prose-news mt-8">
      <Content />
    </div>
  </article>
</Layout>
