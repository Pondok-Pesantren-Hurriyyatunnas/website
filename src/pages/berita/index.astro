---
import Layout from '../../layouts/Layout.astro';
import PageHeader from '../../components/PageHeader.astro';
import NewsCard from '../../components/NewsCard.astro';
import { getPublishedNews } from '../../lib/format';

const posts = await getPublishedNews();
---

<Layout title="Berita" description="Berita dan kegiatan terbaru pondok pesantren.">
  <PageHeader title="Berita & Kegiatan" subtitle="Kabar terbaru dari lingkungan pondok." />

  <section class="mx-auto max-w-6xl px-4 py-16">
    {posts.length > 0 ? (
      <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {posts.map((post) => <NewsCard post={post} />)}
      </div>
    ) : (
      <p class="text-slate-500">Belum ada berita.</p>
    )}
  </section>
</Layout>
