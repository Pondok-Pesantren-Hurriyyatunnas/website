---
interface Props {
  title: string;
  subtitle?: string;
}
const { title, subtitle } = Astro.props;
---

<section class="pattern bg-brand-900 text-white">
  <div class="mx-auto max-w-6xl px-4 py-14 md:py-20">
    <h1 class="text-3xl font-extrabold md:text-4xl">{title}</h1>
    {subtitle && <p class="mt-3 max-w-2xl text-brand-100">{subtitle}</p>}
  </div>
</section>
